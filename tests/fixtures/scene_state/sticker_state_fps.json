{
  "about": "A v2 sticker_state's `fps`: `fps` is each `json` text, `expected` the fps read, or null when the sticker_state is not read (docs/scene-state-v2.md: 0 or less and anything not a number is not read (ADR 0063), the rest is held to 1-1000).",
  "cases": [
    {
      "json": "30",
      "expected": 30
    },
    {
      "json": "29.97",
      "expected": 29.97
    },
    {
      "json": "0",
      "expected": null
    },
    {
      "json": "-5",
      "expected": null
    },
    {
      "json": "\"30\"",
      "expected": null
    },
    {
      "json": "null",
      "expected": null
    },
    {
      "json": "true",
      "expected": null
    },
    {
      "json": "1e-300",
      "expected": 1
    },
    {
      "json": "0.5",
      "expected": 1
    },
    {
      "json": "1e9",
      "expected": 1000
    },
    {
      "json": "1000.5",
      "expected": 1000
    },
    {
      "json": "1e400",
      "expected": null
    },
    {
      "json": "",
      "expected": null
    }
  ]
}
